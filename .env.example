# ai-oss-contributor-agent — 환경변수 예시
#
# 실제 값은 커밋하지 않는다. `.env` 는 .gitignore 대상이며,
# 운영에서는 Secret Manager 또는 CI/CD 환경변수로 주입한다.
# 새 환경변수를 코드에 추가하면 이 파일에도 같은 커밋에서 반영한다.

# ── 데이터베이스 ──────────────────────────────────────────────
# 미설정 시 H2 in-memory 로 기동한다 (application.yml 기본값)
DATABASE_URL=jdbc:postgresql://localhost:5432/oss_agent
DATABASE_USERNAME=oss_agent
DATABASE_PASSWORD=<REPLACE_WITH_SECRET_MANAGER>

# ── Redis ────────────────────────────────────────────────────
# 아직 애플리케이션이 사용하지 않는다 (docker-compose 에만 존재)
REDIS_HOST=localhost
REDIS_PORT=6379

# ── GitHub ───────────────────────────────────────────────────
# 종류: classic PAT · 스코프 public_repo   (Q-1 확정, 2026-09-21)
#
# ⚠ fine-grained PAT 으로 바꾸지 않는다. 더 안전해 보이지만, 우리가 멤버가 아닌
#   upstream 에 PR 을 만들지 못해 PR 생성이 403 으로 죽는다.
#   GitHub App 설치 토큰도 같은 이유로 불가 — open-questions.md Q-1
#
# ⚠ classic PAT 은 저장소별 권한 제한이 불가능하다. 원본 write 를 권한으로 막을 수 없고,
#   push 직전 owner 어설션이 유일한 방어다 — safety-boundaries.md S-1
GITHUB_TOKEN=<REPLACE_WITH_SECRET_MANAGER>

# Fork 소유 계정. 비어 있으면 S-1 어설션이 무력해진다 — 반드시 채운다
GITHUB_FORK_OWNER=

# ── LLM ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<REPLACE_WITH_SECRET_MANAGER>
ANTHROPIC_MODEL=claude-sonnet-5

# ── Sandbox ──────────────────────────────────────────────────
# 대상 저장소 빌드·테스트는 반드시 이 샌드박스 안에서만 실행한다 — safety-boundaries.md S-3
SANDBOX_DOCKER_IMAGE=eclipse-temurin:21-jdk
# 🔴 SANDBOX_NETWORK 는 제거했다 (#17). 실행 단계 격리가 배포 설정 한 줄로 꺼지면 안 된다.
#    네트워크는 명령 타입이 정한다 — 실행·씨딩은 none 고정이고, 네트워크가 열리는 것은
#    워밍 단계뿐이다. 근거는 safety-boundaries.md S-3.
# 워밍 전용 네트워크. ⚠ host·container:<id>·bridge 는 코드가 거부한다 — host 는 컨테이너가
# 호스트 네트워크 네임스페이스를 공유하게 만들어 전용 네트워크를 둔 목적이 뒤집힌다
SANDBOX_WARM_NETWORK=oss-agent-warm
# 🔴 바인드를 허용할 루트. 없으면 「모든 경로가 루트 하위」가 되어 경로 제한이 무력해진다.
#    절대경로여야 하고, 기동 시점에 검증한다
SANDBOX_WORKSPACE_ROOT=build/sandbox-workspaces
SANDBOX_CPU_LIMIT=2
# ⚠ 단위를 붙인다 (4GB · 512MB). 단위 없는 값은 바인딩되지 않는다
SANDBOX_MEMORY_LIMIT=4GB
# fork 폭탄 방어. CPU·메모리 상한만으로는 호스트 PID 공간 고갈을 막지 못한다
SANDBOX_PIDS_LIMIT=512
SANDBOX_TIMEOUT_SECONDS=1800
# 워밍은 실행보다 짧게
SANDBOX_WARM_TIMEOUT_SECONDS=1200
# 🔴 로그 수집이 매달리면 컨테이너 제거에 도달하지 못해 누수가 난다
SANDBOX_LOG_TIMEOUT_SECONDS=60
# 빌드 로그는 수백 MB 가 될 수 있다. 스트리밍 중 끊고, 잘린 사실을 결과에 남긴다
SANDBOX_MAX_OUTPUT_CHARS=200000
# ⚠ docker-java 는 API 버전을 협상하지 않는다 (Q-9b). 핀이지 고정이 아니다 —
#   데몬이 이보다 낮으면 내려야 한다
SANDBOX_DOCKER_API_VERSION=1.44
